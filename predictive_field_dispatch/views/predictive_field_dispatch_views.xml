<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_predictive_field_dispatch" model="ir.actions.act_window">
        <field name="name">Predictive Field Dispatch Optimizer</field>
        <field name="res_model">ai.dispatch.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_predictive_field_dispatch_tree" model="ir.ui.view">
        <field name="name">ai.dispatch.job.tree</field>
        <field name="model">ai.dispatch.job</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_predictive_field_dispatch_form" model="ir.ui.view">
        <field name="name">ai.dispatch.job.form</field>
        <field name="model">ai.dispatch.job</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="predictive_field_dispatch_menu_root" model="ir.ui.menu">
        <field name="name">Predictive Field Dispatch Optimizer</field>
        <field name="sequence">70</field>
    </record>

    <record id="predictive_field_dispatch_menu_main" model="ir.ui.menu">
        <field name="name">Dashboard</field>
        <field name="parent_id" ref="predictive_field_dispatch_menu_root"/>
        <field name="action" ref="action_predictive_field_dispatch"/>
        <field name="sequence">10</field>
    </record>
</odoo>
