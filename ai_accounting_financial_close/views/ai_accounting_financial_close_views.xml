<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_ai_accounting_financial_close" model="ir.actions.act_window">
        <field name="name">AI Accounting &amp; Financial Close Automation Suite</field>
        <field name="res_model">ai.accounting.close</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_ai_accounting_financial_close_tree" model="ir.ui.view">
        <field name="name">ai.accounting.close.tree</field>
        <field name="model">ai.accounting.close</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_ai_accounting_financial_close_form" model="ir.ui.view">
        <field name="name">ai.accounting.close.form</field>
        <field name="model">ai.accounting.close</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_accounting_financial_close_menu_root" model="ir.ui.menu">
        <field name="name">AI Accounting &amp; Financial Close Automation Suite</field>
        <field name="sequence">70</field>
    </record>

    <record id="ai_accounting_financial_close_menu_main" model="ir.ui.menu">
        <field name="name">Dashboard</field>
        <field name="parent_id" ref="ai_accounting_financial_close_menu_root"/>
        <field name="action" ref="action_ai_accounting_financial_close"/>
        <field name="sequence">10</field>
    </record>
</odoo>
